<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Older runtimes exercise package compatibility, not product build targets. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NETSDK1138</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageDownload Include="Microsoft.Identity.Client.Desktop.WinUI3" Version="[4.91.1]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.identity.client.desktop.winui3\4.91.1\lib\net8.0-windows10.0.17763\Microsoft.Identity.Client.Desktop.WinUI3.dll"
             Link="released-winui3\Microsoft.Identity.Client.Desktop.WinUI3.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireCompatibilityPackageVersion" BeforeTargets="CollectPackageReferences"
          Condition="'$(MsalCompatibilityPackageVersion)' == ''">
    <Error Text="Set MsalCompatibilityPackageVersion to the unique locally packed MSAL version and add its directory to RestoreAdditionalProjectSources." />
  </Target>
</Project>
